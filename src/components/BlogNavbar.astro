---
/* src/components/BlogNavbar.astro */
---
<nav class="blog-navbar">
  <div class="navbar-container">
    <!-- Enlace de regreso al portal institucional -->
    <a href="https://culturaydesarrollo.org" class="navbar-brand">
      ← <span>Cultura y Desarrollo</span>
    </a>
    
    <!-- Enlaces directos y simplificados -->
<ul class="navbar-links">
  <li><a href="https://blog.culturaydesarrollo.org/">Inicio Blog</a></li>
  <li>

    <a href="https://culturaydesarrollo.org" #contacto>
      Contacto
    </a>
  </li>
</ul>
  </div>
</nav>

<style>
  /* Menú flotante superior específico para el Blog */
  .blog-navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 65px;
    background-color: #ffffff;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    border-bottom: 1px solid var(--color-border, #e2e8f0);
    z-index: 1000;
    display: flex;
    align-items: center;
  }

  .navbar-container {
    width: 100%;
    max-width: 850px; /* Alineado perfectamente con el ancho de lectura del blog */
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .navbar-brand {
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-secondary, #328cc1);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .navbar-brand span {
    color: var(--color-primary, #0b3c5d);
    font-weight: 700;
    margin-left: 0.25rem;
  }

  .navbar-brand:hover span {
    color: var(--color-secondary, #328cc1);
  }

  .navbar-links {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
  }

  .navbar-links a {
    color: var(--color-text, #2c3e50);
    font-weight: 500;
    font-size: 0.95rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .navbar-links a:hover {
    color: var(--color-secondary, #328cc1);
  }

  /* Botón de Contacto */
  .navbar-links .nav-btn {
    background-color: var(--color-primary, #0b3c5d);
    color: #ffffff;
    padding: 0.4rem 1rem;
    border-radius: 4px;
    font-size: 0.9rem;
    transition: background-color 0.2s ease;
  }

  .navbar-links .nav-btn:hover {
    background-color: var(--color-secondary, #328cc1);
    color: #ffffff;
    text-decoration: none;
  }
</style>

---
/* src/components/BlogNavbar.astro */
const { contactHref = '/#contacto' } = Astro.props;
---
<nav class="blog-navbar">
  <div class="navbar-container">
    <!-- Enlace de regreso al portal institucional -->
    <a href="https://culturaydesarrollo.org" class="navbar-brand">
      <img src="/images/logo.svg" alt="Cultura y Desarrollo" />
      ← <span>Cultura y Desarrollo</span>
    </a>
    
    <!-- Enlaces directos y simplificados -->
<ul class="navbar-links">
  <li><a href="https://blog.culturaydesarrollo.org">Inicio Blog</a></li>
  <li>
    <a href={contactHref} class="nav-btn">
      Contacto
    </a>
  </li>
</ul>
  </div>
</nav>

<style>
  /* Menú flotante superior específico para el Blog */
  .blog-navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 65px;
    background-color: #ffffff;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    border-bottom: 1px solid var(--color-border, #e4d7cf);
    z-index: 1000;
    display: flex;
    align-items: center;
  }

  .navbar-container {
    width: 100%;
    max-width: 850px; /* Alineado perfectamente con el ancho de lectura del blog */
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .navbar-brand {
    align-items: center;
    display: inline-flex;
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-secondary, #9a5f3f);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .navbar-brand img {
    height: 38px;
    margin-right: 0.65rem;
    object-fit: contain;
    width: 70px;
  }

  .navbar-brand span {
    color: var(--color-primary, #24130f);
    font-weight: 700;
    margin-left: 0.25rem;
  }

  .navbar-brand:hover span {
    color: var(--color-secondary, #9a5f3f);
  }

  .navbar-links {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
  }

  .navbar-links a {
    color: var(--color-text, #3f302b);
    font-weight: 500;
    font-size: 0.95rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .navbar-links a:hover {
    color: var(--color-secondary, #9a5f3f);
  }

  /* Botón de Contacto */
  .navbar-links .nav-btn {
    background-color: var(--color-primary, #24130f);
    color: #ffffff;
    padding: 0.4rem 1rem;
    border-radius: 4px;
    font-size: 0.9rem;
    transition: background-color 0.2s ease;
  }

  .navbar-links .nav-btn:hover {
    background-color: var(--color-secondary, #9a5f3f);
    color: #ffffff;
    text-decoration: none;
  }

  @media (max-width: 560px) {
    .navbar-container {
      padding: 0 1rem;
    }

    .navbar-brand span {
      display: none;
    }

    .navbar-brand img {
      height: 34px;
      margin-right: 0.45rem;
      width: 62px;
    }

    .navbar-links {
      gap: 0.75rem;
    }

    .navbar-links a {
      font-size: 0.85rem;
    }
  }
</style>

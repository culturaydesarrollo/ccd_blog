---
import { getCollection } from 'astro:content';
import ContactForm from '../components/ContactForm.astro';
import BackToTop from '../components/BackToTop.astro';
import Layout from '../layouts/Layout.astro';
import { formatDate } from '../lib/formatDate';
import { slugify } from '../lib/slugify';

// 1. Force Astro to fetch all entries inside the src/content/blog/ folder
const posts = await getCollection('blog');

// 2. Sort the articles by publication date (most recent first)
const sortedPosts = posts.sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);
---

<Layout
    title="Blog | Cultura y Desarrollo"
    description="Espacio de difusión, análisis y gestión cultural comunitaria."
>
<Fragment slot="head">
    <style>
        .author-trigger {
            background: transparent;
            border: 0;
            cursor: pointer;
            padding: 0;
        }
        .author-trigger img {
            transition: transform 0.2s ease;
        }
        .author-trigger:hover img, .author-trigger:focus-visible img {
            transform: scale(1.1);
        }
        .author-modal {
            border: 0;
            border-radius: 10px;
            box-shadow: 0 18px 50px rgba(36, 19, 15, 0.24);
            color: var(--color-text);
            max-width: 420px;
            padding: 2rem;
            width: calc(100% - 2rem);
        }
        .author-modal::backdrop {
            background: rgba(36, 19, 15, 0.45);
        }
        .author-modal h2 {
            color: var(--color-primary);
            margin: 0;
        }
        .author-modal-heading {
            align-items: center;
            display: flex;
            gap: 1rem;
            margin-bottom: 0.75rem;
        }
        .author-modal-image {
            border-radius: 50%;
            flex: 0 0 72px;
            height: 72px;
            object-fit: cover;
            width: 72px;
        }
        .author-modal-close {
            background: var(--color-primary);
            border: 0;
            border-radius: 4px;
            color: #ffffff;
            cursor: pointer;
            margin-top: 1rem;
            padding: 0.6rem 1rem;
        }
    </style>
</Fragment>

    <div class="blog-container" style="padding-top: 95px; max-width: 850px; margin: 0 auto; padding-left: 1.5rem; padding-right: 1.5rem;">
        <header style="margin-bottom: 3rem; margin-top: 1.5rem;">
            <h1 style="color: var(--color-primary); font-size: 2.3rem; margin-bottom: 0.5rem;">Blog de Cultura y Desarrollo</h1>
            <p style="color: #667085; margin: 0;">Espacio de difusión, análisis y gestión cultural comunitaria.</p>
        </header>

        <main>
            {sortedPosts.length === 0 ? (
                <div style="padding: 2rem; background: var(--color-bg-alt); border-radius: 8px; text-align: center;">
                    <p style="margin: 0; color: #667085;">No se encontraron artículos en la carpeta src/content/blog/</p>
                </div>
            ) : (
                <ul style="list-style: none; padding: 0; margin: 0;">
                    {sortedPosts.map(post => (
                        <li class="post-item" style="background: var(--color-bg-alt); padding: 2rem; margin-bottom: 1.5rem; border-radius: 8px; border-left: 5px solid var(--color-secondary);">
                            <div style="display: flex; flex-direction: column; align-items: flex-start; gap: 0.35rem; margin-bottom: 0.75rem;">
                                <span style="display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.85rem; color: #718096;">
                                    <button class="author-trigger" type="button" data-author-modal={`author-modal-${post.id}`} aria-label={`Ver biografía de ${post.data.author}`}>
                                        <img src={post.data.authorImage} alt={`Foto de ${post.data.author}`} width="28" height="28" style="border-radius: 50%; object-fit: cover; vertical-align: middle;" />
                                    </button>
                                    <span>Por {post.data.author}</span>
                                </span>
                                <time style="font-size: 0.85rem; color: #718096;">
                                    {formatDate(post.data.pubDate)}
                                </time>
                            </div>
                            <span style="display: inline-flex; gap: 0.5rem; flex-wrap: wrap; font-size: 0.85rem; font-weight: 600; color: var(--color-secondary); text-transform: uppercase;">
                                {post.data.category.map((category, index) => (
                                    <span style="display: inline-flex; gap: 0.5rem;">
                                        {index > 0 && <span aria-hidden="true">/</span>}
                                        <a href={`/categorias/${slugify(category)}/`} style="color: inherit; text-decoration: none;">{category}</a>
                                    </span>
                                ))}
                            </span>
                            
                            <h2 style="margin: 0.5rem 0; font-size: 1.6rem;">
                                <a href={`/${post.id}/`} style="color: var(--color-primary); text-decoration: none; font-weight: 700;">
                                    {post.data.title}
                                </a>
                            </h2>
                            
                            <p style="margin: 0 0 1rem 0; color: var(--color-text);">{post.data.description}</p>
                            
                            <a class="read-more" href={`/${post.id}/`} style="font-weight: 600; font-size: 0.95rem;">
                                Leer artículo →
                            </a>
                            <dialog class="author-modal" id={`author-modal-${post.id}`}>
                                <div class="author-modal-heading">
                                    <img class="author-modal-image" src={post.data.authorImage} alt={`Foto de ${post.data.author}`} width="72" height="72" />
                                    <h2>{post.data.author}</h2>
                                </div>
                                <p>{post.data.authorBio}</p>
                                <button class="author-modal-close" type="button">Cerrar</button>
                            </dialog>
                        </li>
                    ))}
                </ul>
            )}
        </main>
        <ContactForm postTitle="Consulta general del blog" />
        <BackToTop />
    </div>
    <script is:inline>
        document.querySelectorAll('[data-author-modal]').forEach((trigger) => {
            const modal = document.getElementById(trigger.dataset.authorModal);
            const closeButton = modal?.querySelector('.author-modal-close');
            if (!modal || !closeButton) return;

            trigger.addEventListener('click', () => modal.showModal());
            closeButton.addEventListener('click', () => modal.close());
            modal.addEventListener('click', (event) => {
                if (event.target === modal) modal.close();
            });
        });
    </script>
</Layout>

---
import { getCollection } from 'astro:content';
import BlogNavbar from '../components/BlogNavbar.astro'; // Importación del Navbar del blog
import '../styles/global.css';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blog | Cultura y Desarrollo</title>
</head>
<body>
    <!-- Añadimos el menú exclusivo del blog -->
    <BlogNavbar />

    <!-- El contenedor del blog con un padding-top para evitar superposiciones -->
    <div class="blog-container" style="padding-top: 85px; max-width: 850px; margin: 0 auto; padding-left: 1.5rem; padding-right: 1.5rem;">
        <header style="margin-bottom: 3rem; margin-top: 1.5rem;">
            <h1 style="color: var(--color-primary); font-size: 2.3rem; margin-bottom: 0.5rem;">Blog de Cultura y Desarrollo</h1>
            <p style="color: #667085; margin: 0;">Espacio de difusión, análisis y gestión cultural comunitaria.</p>
        </header>
        <main>
            <section class="post-grid" aria-label="Artículos del blog">
                {sortedPosts.map(post => (
                    <article class="post-card">
                        <p class="post-category">{post.data.category}</p>
                        <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
                        <p>{post.data.description}</p>
                        <a class="read-more" href={`/blog/${post.id}/`}>Leer artículo →</a>
                    </article>
                ))}
            </section>
        </main>
    </div>
</body>
</html>

<style>
    .post-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1.5rem;
    }

    .post-card {
        display: flex;
        flex-direction: column;
        padding: 1.5rem;
        background: var(--color-bg-alt);
        border-top: 4px solid var(--color-secondary);
        border-radius: 8px;
    }

    .post-category {
        margin: 0 0 0.5rem;
        color: var(--color-secondary);
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    .post-card h2 {
        margin: 0 0 0.75rem;
        font-size: 1.35rem;
        line-height: 1.3;
    }

    .post-card > p:not(.post-category) {
        margin: 0 0 1.25rem;
    }

    .read-more {
        margin-top: auto;
        font-weight: 600;
    }
</style>

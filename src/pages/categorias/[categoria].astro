---
import { getCollection } from 'astro:content';
import BlogNavbar from '../../components/BlogNavbar.astro';
import { slugify } from '../../lib/slugify';
import '../../styles/global.css';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const categories = [...new Map(
    allPosts
      .flatMap((post) => post.data.category)
      .map((category) => [slugify(category), category])
  )];

  return categories.map(([categorySlug, categoryName]) => ({
    params: { categoria: categorySlug },
    props: {
      categoryName,
      posts: allPosts.filter((post) =>
        post.data.category.some((category) => slugify(category) === categorySlug)
      ),
    },
  }));
}

const { categoryName, posts } = Astro.props;
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Artículos de {categoryName} | Blog</title>
    <style>
        .category-container {
            max-width: 850px;
            margin: 0 auto;
            padding: 3rem 1.5rem;
            padding-top: 95px;
        }
        .category-header {
            margin-bottom: 3rem;
            border-bottom: 2px solid var(--color-border);
            padding-bottom: 1.5rem;
        }
        .category-label {
            display: inline-block;
            background-color: var(--color-secondary);
            color: #ffffff;
            padding: 0.2rem 0.8rem;
            border-radius: 4px;
            font-size: 1rem;
            font-weight: 600;
        }
        .category-header h1 {
            color: var(--color-primary);
            font-size: 2.3rem;
            margin: 0.5rem 0;
        }
        .post-item {
            background: var(--color-bg-alt);
            padding: 2rem;
            margin-bottom: 1.5rem;
            border-radius: 8px;
            border-left: 5px solid var(--color-secondary);
        }
        .post-title a {
            color: var(--color-primary);
            text-decoration: none;
            font-size: 1.6rem;
            font-weight: 700;
        }
        .post-title a:hover {
            color: var(--color-secondary);
        }
        .post-meta {
            font-size: 0.85rem;
            color: #718096;
        }
    </style>
</head>
<body>
    <BlogNavbar />

    <div class="category-container">
        <header class="category-header">
            <a href="/" style="color: var(--color-secondary); text-decoration: none; font-size: 0.95rem;">← Volver al inicio del blog</a>
            <div style="margin-top: 1rem;">
                <span class="category-label">Categoría</span>
                <h1>{categoryName}</h1>
                <p style="color: #667085; margin: 0;">Artículos publicados en esta categoría.</p>
            </div>
        </header>

        <main>
            <ul style="list-style: none; padding: 0;">
                {sortedPosts.map((post) => (
                    <li class="post-item">
                        <div class="post-meta">
                            {post.data.pubDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
                            <span style="margin-left: 1rem;">Por {post.data.author}</span>
                        </div>
                        <h2 class="post-title" style="margin: 0.5rem 0;">
                            <a href={`/${post.id}/`}>{post.data.title}</a>
                        </h2>
                        <p style="margin-bottom: 1rem; color: var(--color-text);">{post.data.description}</p>
                        <a href={`/${post.id}/`} style="font-weight: 600; font-size: 0.95rem;">Leer artículo →</a>
                    </li>
                ))}
            </ul>
        </main>
    </div>
</body>
</html>
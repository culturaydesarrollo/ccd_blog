---
import { getCollection } from 'astro:content';
import BlogNavbar from '../components/BlogNavbar.astro'; // Importación del Navbar del blog
import '../styles/global.css'; // <-- Importamos los mismos colores corporativos

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content } = await entry.render();
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{entry.data.title} | Blog</title>
    <style>
        .article-container {
            max-width: 750px;
            margin: 0 auto;
            padding: 3rem 1.5rem;
        }
        h1 {
            color: var(--color-primary);
            font-size: 2.3rem;
            line-height: 1.2;
        }
        .article-content :global(h2), .article-content :global(h3) {
            color: var(--color-primary);
            margin-top: 2rem;
        }
        .article-content :global(blockquote) {
            border-left: 4px solid var(--color-secondary);
            background: var(--color-bg-alt);
            padding: 1rem;
            margin: 1.5rem 0;
        }
    </style>
</head>
<body>
    <!-- Añadimos el menú exclusivo del blog -->
    <BlogNavbar />

    <div class="article-container">
        <nav style="margin-bottom: 2rem;"><a href="/blog/">← Volver al blog</a></nav>
        <article>
            <header style="margin-bottom: 2rem; border-bottom: 1px solid var(--color-border); padding-bottom: 1rem;">
                <h1>{entry.data.title}</h1>
                <span style="color: #718096;">{entry.data.pubDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
            </header>
            <div class="article-content"><Content /></div>
        </article>
    </div>
</body>
</html>

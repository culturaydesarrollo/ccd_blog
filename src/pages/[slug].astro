---
// src/pages/[slug].astro - Forzar compilación limpia Astro v5
import { getCollection, render } from 'astro:content'; // <-- IMPORTACIÓN CORRECTA DE ASTRO v5
import { Image } from 'astro:assets';
import BlogNavbar from '../components/BlogNavbar.astro';
import ContactForm from '../components/ContactForm.astro';
import BackToTop from '../components/BackToTop.astro';
import { slugify } from '../lib/slugify';
import '../styles/global.css';

// 1. Generar las rutas estáticas para cada artículo
export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  
  // Ordenar cronológicamente (más antiguos primero)
  const sortedEntries = blogEntries.sort(
    (a, b) => a.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );

  return sortedEntries.map((entry, index) => {
    const prevPost = index > 0 ? sortedEntries[index - 1] : null;
    const nextPost = index < sortedEntries.length - 1 ? sortedEntries[index + 1] : null;

    return {
      params: { slug: entry.id }, 
      props: { entry, prevPost, nextPost },
    };
  });
}

const { entry, prevPost, nextPost } = Astro.props;

// 2. SOLUCIÓN COMPATIBLE CON ASTRO v5: Renderizado externo y asíncrono
const { Content } = await render(entry);

// 3. Algoritmo de artículos relacionados libre de colapsos
const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter(post => post.id !== entry.id)
  .map(post => {
    let score = 0;
        if (post.data.category.some(category => entry.data.category.includes(category))) score += 3;
    const commonTags = post.data.tags.filter(tag => entry.data.tags.includes(tag));
    score += commonTags.length;
    return { post, score };
  })
  .filter(item => item.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 2)
  .map(item => item.post);
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{entry.data.title} | Blog Cultura y Desarrollo</title>
    <meta name="description" content={entry.data.description} />
    <style>
        .article-container {
            max-width: 750px;
            margin: 0 auto;
            padding: 3rem 1.5rem;
            padding-top: 95px;
        }
        .category-badge {
            background-color: var(--color-primary);
            color: #ffffff;
            padding: 0.3rem 0.8rem;
            border-radius: 4px;
            font-size: 0.85rem;
            font-weight: 600;
            display: inline-block;
        }
        h1 {
            color: var(--color-primary);
            font-size: 2.4rem;
            line-height: 1.2;
            margin: 0.75rem 0;
        }
        .meta-info {
            color: #718096;
            font-size: 0.9rem;
            display: flex;
            gap: 1rem;
            margin-bottom: 1.5rem;
        }
        .article-content {
            margin-top: 2rem;
            font-size: 1.1rem;
        }
        :global(.article-inline-image) {
            margin: 0 auto 1.5rem;
            max-width: 380px;
        }
        :global(.article-inline-image img) {
            border-radius: 8px;
            display: block;
            height: auto;
            max-width: 100%;
            width: 100%;
        }
        :global(.article-inline-image figcaption) {
            color: #718096;
            font-size: 0.9rem;
            margin-top: 0.5rem;
            text-align: center;
        }
        :global(.article-post-share) {
            align-items: center;
            border-top: 1px solid var(--color-border);
            display: flex;
            flex-wrap: wrap;
            gap: 0.45rem;
            justify-content: center;
            margin-top: 2rem;
            padding-top: 1.25rem;
        }
        :global(.article-post-share-label) {
            color: var(--color-primary);
            flex-basis: 100%;
            font-size: 0.95rem;
            font-weight: 600;
            margin: 0 0 0.15rem;
            text-align: center;
        }
        :global(.article-post-share a),
        :global(.article-post-share button) {
            align-items: center;
            background: var(--color-bg-alt);
            border: 1px solid var(--color-border);
            border-radius: 4px;
            color: var(--color-primary);
            cursor: pointer;
            display: inline-flex;
            justify-content: center;
            min-height: 2.4rem;
            min-width: 2.4rem;
            padding: 0.45rem;
            text-decoration: none;
        }
        :global(.article-post-share a:hover),
        :global(.article-post-share a:focus-visible),
        :global(.article-post-share button:hover),
        :global(.article-post-share button:focus-visible) {
            background: var(--color-secondary);
            border-color: var(--color-secondary);
            color: #ffffff;
        }
        :global(.article-post-share svg) {
            fill: currentColor;
            height: 1.25rem;
            width: 1.25rem;
        }
        :global(.article-post-share-status) {
            color: #718096;
            flex-basis: 100%;
            font-size: 0.8rem;
            min-height: 1.2em;
            text-align: center;
        }
        
        /* DISEÑO DE BOTONES DE NAVEGACIÓN CRONOLÓGICA */
        .pagination-container {
            display: flex;
            justify-content: space-between;
            gap: 1rem;
            margin-top: 3rem;
            padding-top: 2rem;
            border-top: 1px solid var(--color-border);
        }
        .pagination-btn {
            flex: 1;
            padding: 1rem;
            background: var(--color-bg-alt);
            border: 1px solid var(--color-border);
            border-radius: 6px;
            text-decoration: none;
            transition: all 0.2s ease;
            display: flex;
            flex-direction: column;
        }
        .pagination-btn:hover, .history-btn:hover {
            border-color: var(--color-secondary);
            background: #ffffff;
        }
        .pagination-btn .label, .history-btn .label {
            font-size: 0.8rem;
            color: #718096;
            text-transform: uppercase;
            font-weight: 600;
            margin-bottom: 0.25rem;
        }
        .pagination-btn .title, .history-btn .title {
            font-size: 0.95rem;
            color: var(--color-primary);
            font-weight: 700;
            line-height: 1.3;
        }
        .pagination-btn.next {
            text-align: right;
            align-items: flex-end;
        }

        /* DISEÑO DEL BOTÓN DE HISTORIAL INTELIGENTE */
        .history-container {
            margin-top: 2rem;
            display: none; 
            margin-bottom: 1.5rem;
        }
        .history-btn {
            display: flex;
            flex-direction: column;
            padding: 1rem;
            border: 1px dashed var(--color-secondary);
            background: #fbf4ef;
            border-radius: 6px;
            text-decoration: none;
            transition: all 0.2s;
        }

        .related-section {
            margin-top: 3rem;
            padding-top: 2rem;
            border-top: 2px solid var(--color-border);
        }
        .author-trigger {
            background: transparent;
            border: 0;
            cursor: pointer;
            padding: 0;
        }
        .author-trigger img {
            transition: transform 0.2s ease;
        }
        .author-trigger:hover img, .author-trigger:focus-visible img {
            transform: scale(1.1);
        }
        .author-modal {
            border: 0;
            border-radius: 10px;
            box-shadow: 0 18px 50px rgba(36, 19, 15, 0.24);
            color: var(--color-text);
            max-width: 420px;
            padding: 2rem;
            width: calc(100% - 2rem);
        }
        .author-modal::backdrop {
            background: rgba(36, 19, 15, 0.45);
        }
        .author-modal h2 {
            color: var(--color-primary);
            margin: 0;
        }
        .author-modal-heading {
            align-items: center;
            display: flex;
            gap: 1rem;
            margin-bottom: 0.75rem;
        }
        .author-modal-image {
            border-radius: 50%;
            flex: 0 0 72px;
            height: 72px;
            object-fit: cover;
            width: 72px;
        }
        .author-modal-close {
            background: var(--color-primary);
            border: 0;
            border-radius: 4px;
            color: #ffffff;
            cursor: pointer;
            margin-top: 1rem;
            padding: 0.6rem 1rem;
        }
    </style>
</head>
<body id="top">

    <BlogNavbar contactHref="#contacto" />

    <div class="article-container">
        <!-- Datos ocultos para uso del script de memoria -->
        <div id="current-post-data" data-id={entry.id} data-title={entry.data.title} style="display:none;"></div>

        <article>
            <header style="border-bottom: 1px solid var(--color-border); padding-bottom: 1rem;">
                <span class="category-badge">
                    {entry.data.category.map((category, index) => (
                        <span>
                            {index > 0 && ' / '}
                            <a href={`/categorias/${slugify(category)}/`} style="color: inherit; text-decoration: none;">{category}</a>
                        </span>
                    ))}
                </span>
                <h1>{entry.data.title}</h1>
                
                <div class="meta-info" style="align-items: center;">
                    <span style="display: inline-flex; align-items: center; gap: 0.6rem;">
                        <button class="author-trigger" type="button" data-author-modal="author-modal" aria-label={`Ver biografía de ${entry.data.author}`}>
                            <img src={entry.data.authorImage} alt={`Foto de ${entry.data.author}`} width="44" height="44" style="border-radius: 50%; object-fit: cover;" />
                        </button>
                        <span>Por <strong>{entry.data.author}</strong></span>
                    </span>
                    <span>•</span>
                    <time>{entry.data.pubDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
                </div>

                {/* ETIQUETAS INTERACTIVAS */}
                {entry.data.tags && entry.data.tags.length > 0 && (
                    <div class="tag-list" style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.5rem;">
                        {entry.data.tags.map(tag => (
                            <a 
                                href={`/tags/${slugify(tag)}/`} 
                                class="tag-item" 
                                style="background: var(--color-bg-alt); padding: 0.3rem 0.7rem; border-radius: 4px; font-size: 0.85rem; color: var(--color-text); text-decoration: none; border: 1px solid var(--color-border); transition: all 0.2s;"
                                onmouseover="this.style.borderColor='var(--color-secondary)'; this.style.color='var(--color-secondary)';"
                                onmouseout="this.style.borderColor='var(--color-border)'; this.style.color='var(--color-text)';"
                            >
                                #{tag}
                            </a>
                        ))}
                    </div>
                )}

                {entry.data.image && (
                    <Image src={entry.data.image} alt={entry.data.title} style="width: 100%; height: auto; border-radius: 8px; margin-top: 1rem; max-height: 380px; object-fit: cover;" />
                )}
            </header>

            <div class="article-content">
                <Content />
            </div>
            <div class="article-post-share" id="post-share" aria-label="Compartir post"></div>
        </article>

        <dialog class="author-modal" id="author-modal">
            <div class="author-modal-heading">
                <img class="author-modal-image" src={entry.data.authorImage} alt={`Foto de ${entry.data.author}`} width="72" height="72" />
                <h2>{entry.data.author}</h2>
            </div>
            <p>{entry.data.authorBio}</p>
            <button class="author-modal-close" type="button">Cerrar</button>
        </dialog>

        <!-- COMPONENTE: HISTORIAL ANTERIORMENTE CONSULTADO -->
        <div class="history-container" id="history-box">
            <a href="#" id="history-link" class="history-btn">
                <span class="label">↩️ Regresar al artículo consultado anteriormente</span>
                <span class="title" id="history-title">Cargando...</span>
            </a>
        </div>

        <!-- COMPONENTE: ANTERIOR / SIGUIENTE CRONOLÓGICO -->
        <nav class="pagination-container" aria-label="Navegación de artículos">
            {prevPost ? (
                <a href={`/${prevPost.id}/`} class="pagination-btn prev">
                    <span class="label">← Más Antiguo</span>
                    <span class="title">{prevPost.data.title}</span>
                </a>
            ) : (
                <div style="flex: 1;"></div>
            )}

            {nextPost ? (
                <a href={`/${nextPost.id}/`} class="pagination-btn next">
                    <span class="label">Más Reciente →</span>
                    <span class="title">{nextPost.data.title}</span>
                </a>
            ) : (
                <div style="flex: 1;"></div>
            )}
        </nav>

        <!-- RECOMENDACIONES -->
        {relatedPosts.length > 0 && (
            <section class="related-section">
                <h2 style="color: var(--color-primary); font-size: 1.4rem; margin-bottom: 1rem;">Artículos relacionados</h2>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem;">
                    {relatedPosts.map(post => (
                        <div style="background: var(--color-bg-alt); padding: 1.25rem; border-radius: 6px; border-top: 3px solid var(--color-secondary);">
                            <h3 style="margin: 0 0 0.5rem 0; font-size: 1.1rem;"><a href={`/${post.id}/`}>{post.data.title}</a></h3>
                            <p style="font-size: 0.9rem; margin: 0 0 0.75rem 0;">{post.data.description}</p>
                            <a href={`/${post.id}/`} style="font-size: 0.85rem; font-weight: 600;">Leer más →</a>
                        </div>
                    ))}
                </div>
            </section>
        )}

        <ContactForm
            postTitle={entry.data.title}
            postAuthor={entry.data.author}
            postDate={entry.data.pubDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
        />
        <BackToTop />
    </div>

    {/* SCRIPT CON COMILLAS INVERTIDAS DE JAVASCRIPT */}
    <script is:inline>
        const sharePageUrl = window.location.href;
        const sharePageTitle = document.title;

        const socialIconPaths = {
            whatsapp: '<path d="M20.5 3.5A11.8 11.8 0 0 0 12.1 0C5.6 0 .3 5.3.3 11.8c0 2.1.5 4.1 1.6 5.9L.2 24l6.5-1.7a11.8 11.8 0 0 0 5.4 1.3h.1c6.5 0 11.8-5.3 11.8-11.8 0-3.1-1.2-6-3.5-8.3Zm-8.4 18.1h-.1c-1.7 0-3.4-.5-4.8-1.3l-.3-.2-3.9 1 1-3.8-.2-.3a9.8 9.8 0 0 1-1.5-5.2C2.3 6.4 6.7 2 12.1 2c2.6 0 5 1 6.9 2.9a9.7 9.7 0 0 1 2.9 6.9c0 5.4-4.4 9.8-9.8 9.8Zm5.4-7.3c-.3-.2-1.7-.8-2-.9-.3-.1-.5-.2-.7.2-.2.3-.7.9-.8 1.1-.2.2-.3.2-.6.1-.3-.2-1.2-.4-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6l.5-.6c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.6-.1-.2-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.1 1.1-1.1 2.6s1.1 3 1.3 3.2c.2.2 2.2 3.4 5.4 4.7.8.3 1.4.5 1.9.6.8.3 1.5.2 2 .1.6-.1 1.7-.7 1.9-1.4.2-.7.2-1.3.1-1.4-.2-.2-.4-.3-.7-.4Z"/>',
            linkedin: '<path d="M4.7 3.1A2.5 2.5 0 1 1-.3 3a2.5 2.5 0 0 1 5 0ZM0 8h4.7v15H0V8Zm7.7 0h4.5v2.1h.1c.6-1.2 2.2-2.5 4.6-2.5 4.9 0 5.8 3.2 5.8 7.4V23H18v-7.1c0-1.7 0-3.9-2.4-3.9s-2.8 1.9-2.8 3.8V23H8.1V8Z" transform="translate(0 0)"/>',
            facebook: '<path d="M13.5 23v-9h3l.5-3.5h-3.5V8.2c0-1 .3-1.7 1.8-1.7h1.9V3.4c-.3 0-1.5-.1-2.8-.1-2.8 0-4.7 1.7-4.7 4.8v2.4H6.5V14h3.2v9h3.8Z"/>',
            x: '<path d="M18.9 2h3.7l-8.1 9.3L24 22h-7.5l-5.9-7.7L3.9 22H.2l8.7-10L0 2h7.7l5.3 7L18.9 2Zm-1.3 17.9h2L6.4 4H4.2l13.4 15.9Z"/>',
            telegram: '<path d="m23.8 2.4-3.6 19.1c-.3 1.4-1.1 1.7-2.2 1.1l-6.1-4.5-2.9 2.8c-.3.3-.5.5-1 .5l.4-6.2L19.7 5c.5-.4-.1-.6-.7-.2L5.5 13.3l-5.8-1.8c-1.3-.4-1.3-1.3.3-1.9L22.6.8c1.1-.4 2 .3 1.2 1.6Z"/>',
                tiktok: '<path d="M15.5 2h3.2c.2 1.8 1.3 3.4 3 4.3v3.3a8.6 8.6 0 0 1-3-.8v6.8a6.4 6.4 0 1 1-5.5-6.3v3.4a3.1 3.1 0 1 0 2.3 3V2Z"/>',
            instagram: '<path fill-rule="evenodd" d="M7 1h10a6 6 0 0 1 6 6v10a6 6 0 0 1-6 6H7a6 6 0 0 1-6-6V7a6 6 0 0 1 6-6Zm0 2a4 4 0 0 0-4 4v10a4 4 0 0 0 4 4h10a4 4 0 0 0 4-4V7a4 4 0 0 0-4-4H7Zm5 3.5A5.5 5.5 0 1 1 6.5 12 5.5 5.5 0 0 1 12 6.5Zm0 2A3.5 3.5 0 1 0 15.5 12 3.5 3.5 0 0 0 12 8.5ZM18.2 5.3a1.3 1.3 0 1 1-1.3 1.3 1.3 1.3 0 0 1 1.3-1.3Z"/>',
            more: '<path d="M5 10.5a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3Zm7 0a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3Zm7 0a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3Z"/>',
            download: '<path d="M11 2h2v11.2l3.6-3.6 1.4 1.4-6 6-6-6 1.4-1.4 3.6 3.6V2Zm-7 18h14v2H4v-2Z"/>'
        };

        const createIcon = (name) => {
            const icon = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
            icon.setAttribute('viewBox', '0 0 24 24');
            icon.setAttribute('aria-hidden', 'true');
            icon.innerHTML = socialIconPaths[name];
            return icon;
        };

        const createShareLink = (label, iconName, href, extraAttributes = {}) => {
            const link = document.createElement('a');
            link.append(createIcon(iconName));
            link.href = href;
            link.target = '_blank';
            link.rel = 'noopener noreferrer';
            link.title = label;
            link.setAttribute('aria-label', label);
            Object.entries(extraAttributes).forEach(([name, value]) => link.setAttribute(name, value));
            return link;
        };

        const copyPostAndOpenInstagram = async () => {
            try {
                await navigator.clipboard.writeText(sharePageUrl);
            } catch {
                // Instagram no ofrece un enlace web para publicar directamente.
            }
            window.open('https://www.instagram.com/', '_blank', 'noopener,noreferrer');
        };

        const sharePostWithDevice = async (statusElement) => {
            if (navigator.share) {
                try {
                    await navigator.share({ title: sharePageTitle, text: sharePageTitle, url: sharePageUrl });
                    statusElement.textContent = 'Post compartido.';
                } catch (error) {
                    if (error.name !== 'AbortError') statusElement.textContent = 'No fue posible compartir el post.';
                }
                return;
            }
            try {
                await navigator.clipboard.writeText(sharePageUrl);
                statusElement.textContent = 'Enlace del post copiado.';
            } catch {
                statusElement.textContent = 'Copia la dirección del post para compartirlo.';
            }
        };

        const postShare = document.getElementById('post-share');
        if (postShare) {
            const encodedText = encodeURIComponent(`${sharePageTitle} ${sharePageUrl}`);
            const encodedUrl = encodeURIComponent(sharePageUrl);
            const shareLabel = document.createElement('p');
            shareLabel.className = 'article-post-share-label';
            shareLabel.textContent = 'Comparta este post';
            const statusElement = document.createElement('span');
            statusElement.className = 'article-post-share-status';
            statusElement.setAttribute('role', 'status');

            const instagramButton = document.createElement('button');
            instagramButton.type = 'button';
            instagramButton.append(createIcon('instagram'));
            instagramButton.title = 'Instagram';
            instagramButton.setAttribute('aria-label', 'Compartir post en Instagram');
            instagramButton.addEventListener('click', copyPostAndOpenInstagram);

            const moreButton = document.createElement('button');
            moreButton.type = 'button';
            moreButton.append(createIcon('more'));
            moreButton.title = 'Copiar enlace';
            moreButton.setAttribute('aria-label', 'Copiar enlace del post');
            moreButton.addEventListener('click', () => sharePostWithDevice(statusElement));

            postShare.append(
                shareLabel,
                createShareLink('LinkedIn', 'linkedin', `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`),
                instagramButton,
                createShareLink('TikTok', 'tiktok', `https://www.tiktok.com/share?url=${encodedUrl}`),
                createShareLink('Telegram', 'telegram', `https://t.me/share/url?url=${encodedUrl}&text=${encodeURIComponent(sharePageTitle)}`),
                createShareLink('WhatsApp', 'whatsapp', `https://wa.me/?text=${encodedText}`),
                createShareLink('Facebook', 'facebook', `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`),
                createShareLink('X', 'x', `https://twitter.com/intent/tweet?text=${encodeURIComponent(sharePageTitle)}&url=${encodedUrl}`),
                moreButton,
                statusElement
            );
        }

        const authorTrigger = document.querySelector('[data-author-modal]');
        const authorModal = document.getElementById('author-modal');
        const authorModalClose = authorModal?.querySelector('.author-modal-close');
        authorTrigger?.addEventListener('click', () => authorModal?.showModal());
        authorModalClose?.addEventListener('click', () => authorModal?.close());
        authorModal?.addEventListener('click', (event) => {
            if (event.target === authorModal) authorModal.close();
        });

        document.addEventListener('DOMContentLoaded', () => {
            const currentEl = document.getElementById('current-post-data');
            if (!currentEl) return;
            
            const currentId = currentEl.getAttribute('data-id');
            const currentTitle = currentEl.getAttribute('data-title');
            const previousPost = JSON.parse(localStorage.getItem('last_visited_post'));

            if (previousPost && previousPost.id !== currentId) {
                const historyBox = document.getElementById('history-box');
                const historyLink = document.getElementById('history-link');
                const historyTitle = document.getElementById('history-title');

                if (historyBox && historyLink && historyTitle) {
                   historyTitle.innerText = previousPost.title;
                   historyLink.href = `/${previousPost.id}/`;
                   historyBox.style.display = 'block';
                }
             }
            
            localStorage.setItem('last_visited_post', JSON.stringify({
                id: currentId,
                title: currentTitle
            }));
        });
    </script>

</body>
</html>
